{
  "name": "aisessionmanager",
  "productName": "PizzaManager",
  "version": "1.2.0",
  "description": "Gestore unificato di terminali, sessioni OpenCode e Claude Code in un'unica finestra",
  "main": "main.js",
  "homepage": "https://github.com/JackGrieco/PizzaManager-releases",
  "author": "PizzaManager <support@example.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist": "electron-builder",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "dist:win": "electron-builder --win -c.npmRebuild=false",
    "install:mac": "sh scripts/install-mac.sh",
    "install:win": "node scripts/install-win.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aisessionmanager.app",
    "productName": "PizzaManager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "app/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!assets/generate-icon.py",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    "npmRebuild": true,
    "artifactBuildCompleted": "scripts/notarize-dmg.js",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "maintainer": "PizzaManager <support@example.com>",
      "category": "Development",
      "icon": "assets/icons",
      "desktop": {
        "entry": {
          "Name": "PizzaManager",
          "Comment": "Gestore unificato terminali, OpenCode e Claude Code",
          "Categories": "Development;Utility;"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "JackGrieco",
      "repo": "PizzaManager-releases",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${os}-${arch}-setup.${ext}"
    },
    "asarUnpack": [
      "app/tmux.conf"
    ]
  },
  "repository": "github:ale-cadei/PizzaManager",
  "engines": {
    "node": ">=22"
  }
}
