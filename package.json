{
  "name": "aisessionmanager",
  "productName": "AISessionManager",
  "version": "1.0.0",
  "description": "Gestore unificato di terminali, sessioni OpenCode e Claude Code in un'unica finestra",
  "main": "main.js",
  "homepage": "https://github.com/aisessionmanager/aisessionmanager",
  "author": "AISessionManager <support@example.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist": "electron-builder --linux deb AppImage",
    "test:unit": "node tests/run-tests.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aisessionmanager.app",
    "productName": "AISessionManager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    "npmRebuild": true,
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "maintainer": "AISessionManager <support@example.com>",
      "category": "Development",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "AISessionManager",
        "Comment": "Gestore unificato terminali, OpenCode e Claude Code",
        "Categories": "Development;Utility;"
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png"
    }
  }
}
